@model WebBrief.Models.SummaryRequest

@{
    ViewData["Title"] = "WebBrief - AI Website Summarizer";
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

   
    <title>@ViewData["Title"]</title>

    <style>
            * {
                box-sizing: border-box;
            }

            :root {
                --bg: #f5f7fb;
                --card: #ffffff;
                --text: #172033;
                --muted: #687386;
                --border: #e3e7ef;
                --primary: #6366f1;
                --primary-dark: #4f46e5;
                --input: #ffffff;
                --summary-bg: #f8f9ff;
                --shadow: 0 15px 40px rgba(31, 41, 55, 0.08);
            }

            body.dark {
                --bg: #0f172a;
                --card: #111c32;
                --text: #f1f5f9;
                --muted: #94a3b8;
                --border: #26344d;
                --primary: #818cf8;
                --primary-dark: #6366f1;
                --input: #0f172a;
                --summary-bg: #17213a;
                --shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: var(--bg);
                color: var(--text);
                font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
                transition: background 0.25s ease, color 0.25s ease;
            }

            .page {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* Header */

            .header {
                border-bottom: 1px solid var(--border);
                background: var(--card);
            }

            .nav {
                max-width: 1200px;
                margin: auto;
                padding: 18px 24px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 11px;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: linear-gradient( 135deg, var(--primary), #8b5cf6 );
                color: white;
                font-size: 20px;
                font-weight: 700;
                box-shadow: 0 8px 20px rgba(99, 102, 241, 0.25);
            }

            .brand-name {
                font-size: 20px;
                font-weight: 750;
                letter-spacing: -0.4px;
            }

            .brand-subtitle {
                color: var(--muted);
                font-size: 12px;
                margin-top: 2px;
            }

            .theme-btn {
                width: 42px;
                height: 42px;
                border: 1px solid var(--border);
                border-radius: 12px;
                background: var(--card);
                color: var(--text);
                cursor: pointer;
                font-size: 18px;
                transition: 0.2s;
            }

                .theme-btn:hover {
                    border-color: var(--primary);
                    transform: translateY(-1px);
                }

            /* Main */

            main {
                flex: 1;
            }

            .container {
                max-width: 1050px;
                margin: auto;
                padding: 60px 24px;
            }

            .hero {
                text-align: center;
                max-width: 760px;
                margin: 0 auto 42px;
            }

            .badge {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 7px 13px;
                border: 1px solid var(--border);
                border-radius: 999px;
                background: var(--card);
                color: var(--primary);
                font-size: 13px;
                font-weight: 650;
                margin-bottom: 18px;
            }

            .hero h1 {
                margin: 0;
                font-size: clamp(36px, 6vw, 60px);
                line-height: 1.05;
                letter-spacing: -2.5px;
            }

            .gradient-text {
                background: linear-gradient( 90deg, var(--primary), #a855f7 );
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

            .hero p {
                margin: 20px auto 0;
                max-width: 650px;
                color: var(--muted);
                font-size: 17px;
                line-height: 1.7;
            }

            /* Card */

            .card {
                max-width: 850px;
                margin: auto;
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 24px;
                padding: 30px;
                box-shadow: var(--shadow);
            }

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 190px;
                gap: 16px;
            }

            .field {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            label {
                font-size: 13px;
                font-weight: 700;
            }

            input,
            select {
                width: 100%;
                padding: 14px 15px;
                border: 1px solid var(--border);
                border-radius: 12px;
                background: var(--input);
                color: var(--text);
                font-size: 14px;
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

                input:focus,
                select:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
                }

            .url-input {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .url-icon {
                color: var(--muted);
                font-size: 17px;
            }

            .url-input input {
                border: 0;
                padding-left: 0;
                box-shadow: none;
            }

            .url-input {
                border: 1px solid var(--border);
                border-radius: 12px;
                padding: 0 14px;
                background: var(--input);
            }

                .url-input:focus-within {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
                }

            .button-row {
                margin-top: 22px;
            }

            .summarize-btn {
                width: 100%;
                border: 0;
                border-radius: 12px;
                padding: 15px 20px;
                background: linear-gradient( 135deg, var(--primary), #8b5cf6 );
                color: white;
                font-size: 15px;
                font-weight: 750;
                cursor: pointer;
                box-shadow: 0 10px 25px rgba(99, 102, 241, 0.22);
                transition: transform 0.2s, box-shadow 0.2s;
            }

                .summarize-btn:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 14px 30px rgba(99, 102, 241, 0.3);
                }

                .summarize-btn:disabled {
                    opacity: 0.65;
                    cursor: not-allowed;
                    transform: none;
                }

            /* Loading */

            .loading {
                display: none;
                text-align: center;
                margin-top: 20px;
                color: var(--muted);
                font-size: 14px;
            }

            .spinner {
                width: 18px;
                height: 18px;
                display: inline-block;
                border: 2px solid var(--border);
                border-top-color: var(--primary);
                border-radius: 50%;
                animation: spin 0.8s linear infinite;
                vertical-align: middle;
                margin-right: 8px;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            /* Errors */

            .validation {
                margin-top: 20px;
                padding: 13px 15px;
                border-radius: 12px;
                background: rgba(239, 68, 68, 0.08);
                color: #ef4444;
                font-size: 14px;
            }

            /* Summary */

            .summary {
                max-width: 850px;
                margin: 28px auto 0;
                background: var(--summary-bg);
                border: 1px solid var(--border);
                border-radius: 20px;
                padding: 28px;
            }

            .summary-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                margin-bottom: 18px;
            }

            .summary-title {
                font-size: 20px;
                font-weight: 750;
            }

            .ai-label {
                padding: 5px 9px;
                border-radius: 7px;
                background: rgba(99, 102, 241, 0.1);
                color: var(--primary);
                font-size: 11px;
                font-weight: 750;
            }

            .summary-content {
                line-height: 1.75;
                color: var(--text);
                white-space: pre-wrap;
                font-size: 15px;
            }

            /* Features */

            .features {
                max-width: 850px;
                margin: 30px auto 0;
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 14px;
            }

            .feature {
                padding: 20px;
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 16px;
            }

            .feature-icon {
                font-size: 22px;
                margin-bottom: 10px;
            }

            .feature h3 {
                margin: 0 0 6px;
                font-size: 14px;
            }

            .feature p {
                margin: 0;
                color: var(--muted);
                font-size: 13px;
                line-height: 1.5;
            }

            /* Footer */

            footer {
                margin-top: 60px;
                border-top: 1px solid var(--border);
                background: var(--card);
            }

            .footer-content {
                max-width: 1050px;
                margin: auto;
                padding: 35px 24px 25px;
            }

            .how-to {
                margin-bottom: 28px;
            }

                .how-to h2 {
                    margin: 0 0 10px;
                    font-size: 18px;
                }

                .how-to p {
                    margin: 0 0 20px;
                    color: var(--muted);
                    font-size: 13px;
                    line-height: 1.6;
                }

            .steps {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 12px;
            }

            .step {
                display: flex;
                gap: 10px;
                align-items: flex-start;
            }

            .step-number {
                min-width: 28px;
                height: 28px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 8px;
                background: rgba(99, 102, 241, 0.1);
                color: var(--primary);
                font-size: 12px;
                font-weight: 800;
            }

            .step-text {
                color: var(--muted);
                font-size: 12px;
                line-height: 1.5;
            }

                .step-text strong {
                    display: block;
                    color: var(--text);
                    margin-bottom: 3px;
                }

            .copyright {
                padding-top: 20px;
                border-top: 1px solid var(--border);
                text-align: center;
                color: var(--muted);
                font-size: 12px;
            }

            /* Responsive */

            @@media (max-width: 768px) {

                .container {
                    padding: 40px 16px;
                }

                .hero h1 {
                    letter-spacing: -1.5px;
                }

                .hero p {
                    font-size: 15px;
                }

                .card {
                    padding: 20px;
                    border-radius: 18px;
                }

                .form-grid {
                    grid-template-columns: 1fr;
                }

                .features {
                    grid-template-columns: 1fr;
                }

                .steps {
                    grid-template-columns: 1fr 1fr;
                }

                .summary {
                    padding: 20px;
                }
            }

            @@media (max-width: 480px) {

                .brand-subtitle {
                    display: none;
                }

                .brand-name {
                    font-size: 18px;
                }

                .hero h1 {
                    font-size: 38px;
                }

                .steps {
                    grid-template-columns: 1fr;
                }

                .nav {
                    padding: 14px 16px;
                }
            }

            .markdown-body {
                line-height: 1.75;
            }

                .markdown-body h1,
                .markdown-body h2,
                .markdown-body h3 {
                    margin-top: 24px;
                    margin-bottom: 12px;
                    color: var(--text);
                }

                .markdown-body h2 {
                    font-size: 24px;
                }

                .markdown-body h3 {
                    font-size: 18px;
                }

                .markdown-body p {
                    margin: 12px 0;
                }

                .markdown-body strong {
                    font-weight: 750;
                }

                .markdown-body ul,
                .markdown-body ol {
                    padding-left: 25px;
                }

                .markdown-body li {
                    margin-bottom: 7px;
                }

                .markdown-body table {
                    width: 100%;
                    border-collapse: collapse;
                    margin: 20px 0;
                    overflow: hidden;
                    border-radius: 10px;
                }

                .markdown-body th,
                .markdown-body td {
                    padding: 12px 14px;
                    border: 1px solid var(--border);
                    text-align: left;
                    vertical-align: top;
                }

                .markdown-body th {
                    background: rgba(99, 102, 241, 0.1);
                    font-weight: 700;
                }

                .markdown-body tr:nth-child(even) {
                    background: rgba(127, 127, 127, 0.04);
                }

                .markdown-body blockquote {
                    margin: 18px 0;
                    padding: 12px 18px;
                    border-left: 4px solid var(--primary);
                    background: rgba(99, 102, 241, 0.06);
                    border-radius: 6px;
                }

                .markdown-body code {
                    padding: 3px 6px;
                    border-radius: 5px;
                    background: rgba(127, 127, 127, 0.12);
                }

                .markdown-body pre {
                    overflow-x: auto;
                    padding: 16px;
                    border-radius: 10px;
                    background: #111827;
                    color: #f8fafc;
                }

                .markdown-body a {
                    color: var(--primary);
                    text-decoration: none;
                }

                    .markdown-body a:hover {
                        text-decoration: underline;
                    }
    </style>
  

</head>

<body>

    <div class="page">

        <!-- Header -->

        <header class="header">

            <nav class="nav">

                <div class="brand">

                    <div class="brand-icon">
                        W
                    </div>

                    <div>
                        <div class="brand-name">
                            WebBrief
                        </div>

                        <div class="brand-subtitle">
                            AI Website Summarizer
                        </div>
                    </div>

                </div>

                <button type="button"
                        class="theme-btn"
                        id="themeButton"
                        title="Toggle theme">

                    🌙

                </button>

            </nav>

        </header>


        <!-- Main -->

        <main>

            <div class="container">

                <!-- Hero -->

                <section class="hero">

                    <div class="badge">
                        ✨ AI-powered website summaries
                    </div>

                    <h1>
                        Read less.
                        <span class="gradient-text">
                            Understand more.
                        </span>
                    </h1>

                    <p>
                        Paste any website URL and let AI extract the
                        important information for you. Choose your
                        preferred personality and get a clear,
                        useful summary in seconds.
                    </p>

                </section>


                <!-- Form -->

                <section class="card">

                    <form asp-action="Index"
                          method="post"
                          id="summaryForm">

                        <div class="form-grid">

                            <div class="field">

                                <label asp-for="Url">
                                    Website URL
                                </label>

                                <div class="url-input">

                                    <span class="url-icon">
                                        🔗
                                    </span>

                                    <input asp-for="Url"
                                           placeholder="https://example.com"
                                           autocomplete="url" />

                                </div>

                                <span asp-validation-for="Url"
                                      style="color:#ef4444;font-size:12px;">
                                </span>

                            </div>


                            <div class="field">

                                <label asp-for="Personality">
                                    Summary Style
                                </label>

                                <select asp-for="Personality">

                                    <option value="Friendly">
                                        😊 Friendly
                                    </option>

                                    <option value="Expert">
                                        🧠 Expert
                                    </option>

                                    <option value="Executive">
                                        💼 Executive
                                    </option>

                                    <option value="Explain simply">
                                        💡 Explain Simply
                                    </option>

                                </select>

                            </div>

                        </div>


                        <div class="button-row">

                            <button type="submit"
                                    class="summarize-btn"
                                    id="summarizeButton">

                                ✨ Summarize Website

                            </button>

                        </div>


                        <div class="loading"
                             id="loading">

                            <span class="spinner"></span>

                            Reading website and generating your summary...

                        </div>

                    </form>


                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="validation">

                            @foreach (var error in ViewData.ModelState.Values
                                .SelectMany(v => v.Errors))
                            {
                                <div>
                                    @error.ErrorMessage
                                </div>
                            }

                        </div>
                    }

                </section>


                <!-- Summary -->
                @if (!string.IsNullOrWhiteSpace(Model.Summary))
                {
                    <section class="summary">

                        <div class="summary-header">

                            <div class="summary-title">
                                📝 Your Summary
                            </div>

                            <div class="ai-label">
                                AI GENERATED
                            </div>

                        </div>

                        <div class="summary-content">
                           @*  @Model.Summary *@
                            @Html.Raw(Model.Summary)
                        </div>

                    </section>
                }


                <!-- Features -->

                <section class="features">

                    <div class="feature">

                        <div class="feature-icon">
                            🎯
                        </div>

                        <h3>
                            Focused summaries
                        </h3>

                        <p>
                            Navigation menus and unnecessary
                            website content are filtered out.
                        </p>

                    </div>


                    <div class="feature">

                        <div class="feature-icon">
                            🎨
                        </div>

                        <h3>
                            Choose your style
                        </h3>

                        <p>
                            Get Friendly, Expert, Executive,
                            or simple explanations.
                        </p>

                    </div>


                    <div class="feature">

                        <div class="feature-icon">
                            ⚡
                        </div>

                        <h3>
                            Fast & simple
                        </h3>

                        <p>
                            Paste a URL, choose a style,
                            and let AI do the reading.
                        </p>

                    </div>

                </section>

            </div>

        </main>


        <!-- Footer -->

        <footer>

            <div class="footer-content">

                <div class="how-to">

                    <h2>
                        📖 How to use WebBrief
                    </h2>

                    <p>
                        Turn a long website into an easy-to-read
                        summary in four simple steps.
                    </p>


                    <div class="steps">

                        <div class="step">

                            <div class="step-number">
                                1
                            </div>

                            <div class="step-text">

                                <strong>
                                    Paste URL
                                </strong>

                                Enter the website address
                                you want to understand.

                            </div>

                        </div>


                        <div class="step">

                            <div class="step-number">
                                2
                            </div>

                            <div class="step-text">

                                <strong>
                                    Choose style
                                </strong>

                                Select Friendly, Expert,
                                Executive, or Simple.

                            </div>

                        </div>


                        <div class="step">

                            <div class="step-number">
                                3
                            </div>

                            <div class="step-text">

                                <strong>
                                    Summarize
                                </strong>

                                Click the summarize button
                                and let AI read the page.

                            </div>

                        </div>


                        <div class="step">

                            <div class="step-number">
                                4
                            </div>

                            <div class="step-text">

                                <strong>
                                    Read & learn
                                </strong>

                                Review the important points
                                without reading the entire page.

                            </div>

                        </div>

                    </div>

                </div>


                <div class="copyright">

                    © @DateTime.Now.Year WebBrief ·
                    AI-powered website summarization

                </div>

            </div>

        </footer>
      

    </div>

    <script>

            // Theme

            const themeButton =
                document.getElementById("themeButton");

            const savedTheme =
                localStorage.getItem("webbrief-theme");

            if (savedTheme === "dark") {

                document.body.classList.add("dark");

                themeButton.textContent = "☀️";

            }


            themeButton.addEventListener("click", function () {

                document.body.classList.toggle("dark");

                const isDark =
                    document.body.classList.contains("dark");

                localStorage.setItem(
                    "webbrief-theme",
                    isDark ? "dark" : "light"
                );

                themeButton.textContent =
                    isDark ? "☀️" : "🌙";

            });


            // Loading state

            const form =
                document.getElementById("summaryForm");

            const button =
                document.getElementById("summarizeButton");

            const loading =
                document.getElementById("loading");


            form.addEventListener("submit", function () {

                if (!form.checkValidity()) {
                    return;
                }

                button.disabled = true;

                button.textContent =
                    "⏳ Generating Summary...";

                loading.style.display = "block";

            });

    </script>

</body>
</html>
